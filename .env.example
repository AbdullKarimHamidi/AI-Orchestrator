# Copy to .env and fill in. Never commit .env.
# Generate ENCRYPTION_KEYS with:  ./scripts/new-key.sh   (or ./scripts/new-key.ps1 on Windows)

# --- Runtime ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database: this project's MongoDB Atlas cluster (api, worker and docker compose all use it) ---
MONGODB_URI=mongodb+srv://hamidi:hamidi2050@cluster0.rxxertq.mongodb.net/AI
# docker compose would otherwise point the containers at its bundled mongo service.
COMPOSE_MONGODB_URI=mongodb+srv://hamidi:hamidi2050@cluster0.rxxertq.mongodb.net/AI
MONGODB_DB=AI
# Image for the bundled mongo service. On Linux kernel 6.19+ mongo:8.0 refuses to start; use mongo:7.0.
# MONGO_IMAGE=mongo:8.0

# --- Secrets ---
# Fernet key(s), comma-separated. The first key encrypts; all keys decrypt (rotation).
# MUST be identical for api and worker, and must be kept: stored provider keys depend on it.
ENCRYPTION_KEYS=

# --- HTTP / cookies ---
# Browser origins allowed to call the API directly (the web app proxies same-origin, so this
# only matters if you call the API from another site).
CORS_ORIGINS=http://localhost:3000
# Must be true in production (HTTPS only). The API refuses to start in production otherwise.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
MAX_REQUEST_BYTES=1000000
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=10
# Set to false to stop new self-service sign-ups (team members are then added by an admin).
ALLOW_REGISTRATION=true

# --- Worker / execution ---
WORKER_LEASE_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_CONCURRENCY=4
DEFAULT_RUN_TIMEOUT_SECONDS=120
MAX_RUN_TIMEOUT_SECONDS=900

# --- Demo mode: adds a labeled synthetic $0 provider to every workspace ---
DEMO_MODE=true

# --- Retention ---
RUN_EVENTS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# --- Production (docker-compose.prod.yml) ---
# Public URL of the web app; used in invitation links. Must be https:// in production.
PUBLIC_URL=http://localhost:3000
# Domain served by Caddy with an automatic HTTPS certificate, and the email for Let's Encrypt.
DOMAIN=
ACME_EMAIL=
WORKER_REPLICAS=2

# --- Tools and knowledge ---
# Allow tools to call private/internal addresses (10.x, 192.168.x, localhost...). Off by default (SSRF protection).
TOOLS_ALLOW_PRIVATE_NETWORKS=false
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RESPONSE_BYTES=200000
# Largest document upload accepted by the knowledge base.
MAX_UPLOAD_BYTES=25000000
# Knowledge chunk size and overlap, in characters. Changing them affects only documents indexed afterwards.
KNOWLEDGE_CHUNK_CHARS=2400
KNOWLEDGE_CHUNK_OVERLAP=300
