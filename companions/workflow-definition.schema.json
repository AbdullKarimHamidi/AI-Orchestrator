              ]
            },
            "next": "end-failed"
          },
          {
            "id": "end",
            "type": "end",
            "workspace_id": "ws_main",
            "outcome": "success",
            "required_outputs": [
              "$.nodes.synthesis.output.brief"
            ]
          },
          {
            "id": "end-failed",
            "type": "end",
            "workspace_id": "ws_main",
            "outcome": "failure"
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "research-a"
          },
          {
            "from": "research-a",
            "to": "fan-out"
          },
          {
            "from": "fan-out",
            "to": "summarize"
          },
          {
            "from": "fan-out",
            "to": "extract-entities"
          },
          {
            "from": "summarize",
            "to": "join"
          },
          {
            "from": "extract-entities",
            "to": "join"
          },
          {
